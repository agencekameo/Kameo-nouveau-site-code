# ── Variables d'environnement du site ────────────────────────────────────────
# Développement : copier en « .env.local ». Docker : copier en « .env.docker ».
# Ne jamais commiter les copies remplies (tous les .env* sauf celui-ci sont ignorés par git).

# Formulaire de contact (/api/contact/)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=contact@agence-kameo.fr
CONTACT_FROM=

# ── Blog automatisé n8n (API /api/blog/publish/…) ────────────────────────────
# Identifiants que n8n envoie en authentification Basic. Sans eux, l'API refuse tout (401).
# Mot de passe : 32 caractères aléatoires, par exemple : openssl rand -hex 16
BLOG_PUBLISH_USER=
BLOG_PUBLISH_PASSWORD=

# Base PostgreSQL des articles publiés par n8n. Sans elle, le blog n'affiche que les
# articles du dépôt (src/content/blog) et l'API répond 503.
#   Docker : ne pas renseigner DATABASE_URL, docker-compose la construit avec POSTGRES_PASSWORD
#            (lettres et chiffres uniquement : openssl rand -hex 24).
#   Ailleurs : postgres://utilisateur:motdepasse@hote:5432/base (SSL exigé hors réseau local,
#            DB_SSL=false pour le désactiver).
POSTGRES_PASSWORD=
DATABASE_URL=

# Dossier des images déposées par n8n. Docker : /uploads (volume). Par défaut : ./.blog-uploads
BLOG_UPLOADS_ROOT=

# Docker : port local exposé au proxy (nginx/caddy) ; Omega utilise 4004.
APP_PORT=4005
